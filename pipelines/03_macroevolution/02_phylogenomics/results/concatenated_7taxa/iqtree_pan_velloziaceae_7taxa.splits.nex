#nexus

BEGIN Taxa;
DIMENSIONS ntax=7;
TAXLABELS
[1] 'Ath'
[2] 'Dala'
[3] 'Ptec'
[4] 'Abra'
[5] 'Xvis'
[6] 'Vper'
[7] 'Vtub'
;
END; [Taxa]

BEGIN Splits;
DIMENSIONS ntax=7 nsplits=11;
FORMAT labels=no weights=yes confidences=no intervals=no;
MATRIX
	100	 2,
	100	 3,
	100	 4,
	100	 5,
	100	 6,
	100	 7,
	100	 6 7,
	100	 5 6 7,
	100	 1 2 3,
	100	 1 2,
	100	 1,
;
END; [Splits]

