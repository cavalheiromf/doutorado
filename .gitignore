# Standard Gitignore for Vellozia Bioinformatics Pipeline

# Ignore raw and processed large datasets
data/
logs/
chapter3/
teamwork/02_literature_library/papers_openalex_pdf/
*.fastq.gz
*.fq.gz
*.fastq
*.fq
*.bam
*.sam
*.bai
*.fasta
*.fa
*.fai
*.gff
*.gff3
*.gtf
*.tar.gz
*.zip
*.db
*.sqlite
*.bt2
*.sa

# Ignore heavy upstream pipeline intermediate results
chapter2_osca/05_rnaseq/results*/
chapter2_osca/05_rnaseq/raw_data/
chapter_macroevolution/01_orthology/results*/
**/work/

# Ignore Python & Jupyter temp files
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.pytest_cache/

# Ignore R temp files
.Rhistory
.Rapp.history
.RData
.RDataTmp
*-ex.R
/esh/
.Rproj.user/

# Ignore system temporary files
.DS_Store
Thumbs.db
tmp/
temp/
rst
rst1
rub
.agents/
errors.log

# Environment variables & editor
.env
.vscode

# Canonical literature-library path after workspace organization
teamwork/shared/literature_library/papers_openalex_pdf/

# Ignore binary Word documents
*.docx
*.doc

# Heavy pipeline intermediate results
pipelines/*/00_data/
pipelines/*/01_orthology/
pipelines/*/05_selection/
pipelines/*/04_gene_families/
pipelines/*/05_rnaseq/
pipelines/*/exploratory_benchmark/
pipelines/*/02_phylogenomics/input/
pipelines/*/04_manuscript/
pipelines/04_osca/03_synteny/results/
pipelines/04_osca/04_promoters/results/
pipelines/04_osca/06_expression/results_genecounts/
pipelines/04_osca/01_gene_identification/results/
pipelines/04_osca/02_phylogeny/results/
pipelines/04_osca/02_phylogeny/results_support/
pipelines/04_osca/07_ppi_network/results/

# MCMCtree raw chain files
pipelines/*/03_dating/*.txt
pipelines/*/03_dating/*.BV
pipelines/*/03_dating/chain*/

# Workspace config & agent skills lock
doutorado.code-workspace
skills-lock.json
