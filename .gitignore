# Standard Gitignore for Vellozia Bioinformatics Pipeline

# Ignore raw and processed large datasets
data/
logs/
chapter3/
*.fastq.gz
*.fq.gz
*.fastq
*.fq
*.bam
*.sam
*.bai
*.fasta
*.fa
*.fai
*.gff
*.gff3
*.gtf
*.tar.gz
*.zip
*.db
*.sqlite
*.bt2
*.sa

# Ignore heavy upstream pipeline intermediate results
chapter2_osca/05_rnaseq/results*/
chapter2_osca/05_rnaseq/raw_data/
chapter_macroevolution/01_orthology/results*/

# Ignore Python & Jupyter temp files
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.pytest_cache/

# Ignore R temp files
.Rhistory
.Rapp.history
.RData
.RDataTmp
*-ex.R
/esh/
.Rproj.user/

# Ignore system temporary files
.DS_Store
Thumbs.db
tmp/
temp/
rst
rst1
rub
.agents/
errors.log

# Environment variables & editor
.env
.vscode
